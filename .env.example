# Copy to ~/.config/tg-orchestrator/env and chmod 600 it. Never commit the real file.

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=PASTE_TOKEN_HERE
# Your numeric Telegram user id. Messages from anyone else are dropped before
# they reach a model.
OWNER_ID=0

# Optional. Hard cap on one Claude turn (ms). Default 50 minutes; the topic is
# warned 5 minutes before the kill.
#TG_CLAUDE_TIMEOUT_MS=3000000
# Optional. How many topics may be in a turn at once (same topic is always
# serial). Default 3.
#TG_MAX_PARALLEL_TURNS=3
# Optional. Model / effort passed to `claude -p`.
#TG_CLAUDE_MODEL=opus
#TG_CLAUDE_EFFORT=high

# Optional. Message-claim registry (SQLite) shared with other agents on the box.
#CLAIMS_DB=~/.config/claude-agents/claims.sqlite
# Optional. claude-coop checkout, for handing a chat over to another agent.
#CLAIMS_COOP=~/git/claude-coop/coop.sh
# Optional. Extra Claude config dirs for sessions.mjs (comma-separated); by
# default every ~/.claude and ~/.claude-<name> is discovered.
#CLAUDE_HOMES=~/.claude,~/.claude-work
# Optional. Telegram MCP checkout used by scripts/transcribe-fallback.sh.
#TELEGRAM_MCP_DIR=~/git/telegram-mcp
#WHISPER_LANGUAGE=en
